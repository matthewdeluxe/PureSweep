<Application x:Class="PureSweep.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls"
             StartupUri="MainWindow.xaml">
    <!--
        The look matches the macOS version: the window is always dark, with a full-bleed gradient that changes
        colour per page (MainWindow), light text, frosted "glass" cards, pill buttons and one big glowing round
        action button per page. The page's bright accent is pushed into ModernWpf's accent colour, so anything
        that uses SystemAccentColor (the round button, emblems, toggles, checkboxes) follows the page.
        Brushes that use DynamicResource colours are declared inside templates (see CLAUDE.md).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="TextStrong" Color="White" />
            <SolidColorBrush x:Key="TextSoft" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextFaint" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="GlassFill" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassEdge" Color="#1FFFFFFF" />

            <!-- Frosted glass panel. Keeps the old "Card" key so every page picks it up. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Frosted pill button for secondary actions on the gradient. Background tints it (danger, accent). -->
            <ControlTemplate x:Key="PillTemplate" TargetType="Button">
                <Grid x:Name="Root" SnapsToDevicePixels="True">
                    <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="999" />
                    <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="999" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.10" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.18" />
                        <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Face" Property="BorderBrush" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="Push3D" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource PillTemplate}" />
                <Setter Property="Background" Value="#29FFFFFF" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,7,16,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style x:Key="Push3DAccent" TargetType="Button" BasedOn="{StaticResource Push3D}">
                <Setter Property="Background" Value="#40FFFFFF" />
                <Setter Property="BorderBrush" Value="#73FFFFFF" />
            </Style>

            <Style x:Key="Push3DHero" TargetType="Button" BasedOn="{StaticResource Push3D}" />

            <Style x:Key="Push3DDanger" TargetType="Button" BasedOn="{StaticResource Push3D}">
                <Setter Property="Background" Value="#B3D92C3A" />
                <Setter Property="BorderBrush" Value="#66FF8A94" />
            </Style>

            <!-- Underlined text link, e.g. "Scan again" -->
            <Style x:Key="Link" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="13" Foreground="{TemplateBinding Foreground}"
                                       TextDecorations="Underline" Background="Transparent" Opacity="0.8" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="T" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="T" Property="Opacity" Value="1" />
                                    <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="T" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The page's one big round action: frosted face, accent ring and a soft pulsing glow -->
            <ControlTemplate x:Key="RoundPush3DTemplate" TargetType="Button">
                <Grid x:Name="Root" Background="Transparent">
                    <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                    <Ellipse x:Name="Glow" Margin="-18" Opacity="0.55" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0.55" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#47FFFFFF" Offset="0" />
                                <GradientStop Color="#14FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse StrokeThickness="2">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0" />
                                <GradientStop Color="#99FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <Ellipse x:Name="Hover" Fill="White" Opacity="0" />
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 From="0.35" To="0.75" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                        <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="RoundPush3D" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource RoundPush3DTemplate}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Width" Value="124" />
                <Setter Property="Height" Value="124" />
                <!-- keyboard focus: a round outline instead of the default dotted square -->
                <Setter Property="FocusVisualStyle">
                    <Setter.Value>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Ellipse Stroke="White" StrokeThickness="2" Margin="-6" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- Clickable dashboard tile (glass) -->
            <Style x:Key="TileButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                                    CornerRadius="16" Padding="16,14">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#21FFFFFF" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Page header: accent icon tile, large white title, soft subtitle, optional action on the right -->
            <Style TargetType="c:Hero">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:Hero">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="12" Background="#1AFFFFFF" VerticalAlignment="Center">
                                    <ui:FontIcon Glyph="{TemplateBinding Glyph}" FontSize="20">
                                        <ui:FontIcon.Foreground>
                                            <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                                        </ui:FontIcon.Foreground>
                                    </ui:FontIcon>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="26" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{TemplateBinding Subtitle}" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Start-screen emblem: glow, two faint rings, an accent disc with the glyph, and a spinning arc while busy -->
            <Style TargetType="c:Emblem">
                <Setter Property="Width" Value="200" />
                <Setter Property="Height" Value="200" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:Emblem">
                            <Grid>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Opacity>0.3</Ellipse.Opacity>
                                </Ellipse>
                                <Ellipse Stroke="#14FFFFFF" StrokeThickness="1" Margin="4" />
                                <Ellipse Stroke="#10FFFFFF" StrokeThickness="1" Margin="28" />
                                <Ellipse Margin="48">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource SystemAccentColorDark2}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource SystemAccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.7" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ui:FontIcon Glyph="{TemplateBinding Glyph}" FontSize="44" Foreground="White" />
                                <Ellipse x:Name="Arc" Margin="16" StrokeThickness="3" Visibility="Collapsed"
                                         StrokeDashArray="14 400" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Stroke>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="Spin" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSpinning" Value="True">
                                    <Setter TargetName="Arc" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinStory">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1.4" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinStory" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar entry. Content is the icon tile and label; IsChecked marks the current page. -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="GroupName" Value="nav" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="8,6" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavSection" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#73FFFFFF" />
                <Setter Property="Margin" Value="12,16,0,4" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MutedCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
