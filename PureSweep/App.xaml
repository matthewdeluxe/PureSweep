<Application x:Class="PureSweep.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Push button: a flat face sitting on a thin darker lip; pressing slides the face down onto the lip.
                 Deliberately subtle (2px lip, no gloss) so it sits with the flat WinUI controls around it. -->
            <ControlTemplate x:Key="Push3DTemplate" TargetType="Button">
                <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                    <!-- lip (the button's side wall) -->
                    <Border Background="{TemplateBinding BorderBrush}" CornerRadius="7" Margin="0,2,0,0" />
                    <Border Background="#59000000" CornerRadius="7" Margin="0,2,0,0" />
                    <!-- face -->
                    <Grid x:Name="Face" Margin="0,0,0,2">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" />
                        <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="7" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Hover" Property="Background" Value="Black" />
                        <Setter TargetName="Hover" Property="Opacity" Value="0.10" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="2" Duration="0:0:0.05" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="0" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="Push3D" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource Push3DTemplate}" />
                <Setter Property="Background" Value="{DynamicResource SystemControlForegroundChromeHighBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundChromeHighBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,7,18,8" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="Push3DAccent" TargetType="Button" BasedOn="{StaticResource Push3D}">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- For use on top of the accent gradient -->
            <Style x:Key="Push3DHero" TargetType="Button" BasedOn="{StaticResource Push3D}">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#FFB8C4D0" />
                <Setter Property="Foreground" Value="#FF14202B" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="24,11,24,12" />
            </Style>

            <Style x:Key="Push3DDanger" TargetType="Button" BasedOn="{StaticResource Push3D}">
                <Setter Property="Background" Value="#FFD92C3A" />
                <Setter Property="BorderBrush" Value="#FFD92C3A" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Big circular plunger used for the main Scan / Clean action -->
            <ControlTemplate x:Key="RoundPush3DTemplate" TargetType="Button">
                <Grid x:Name="Root" Background="Transparent">
                    <Ellipse Fill="{TemplateBinding BorderBrush}" Margin="0,3,0,0" />
                    <Ellipse Fill="#40000000" Margin="0,3,0,0" />
                    <Grid x:Name="Face" Margin="0,0,0,3">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <Ellipse x:Name="Hover" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0.24" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="3" Duration="0:0:0.06" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="RoundPush3D" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource RoundPush3DTemplate}" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#FFB8C4D0" />
                <Setter Property="Foreground" Value="#FF14202B" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Width" Value="148" />
                <Setter Property="Height" Value="151" />
                <!-- keyboard focus: a round outline instead of the default dotted square -->
                <Setter Property="FocusVisualStyle">
                    <Setter.Value>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Ellipse Stroke="White" StrokeThickness="2" Margin="-5,-5,-5,-2" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- Clickable dashboard tile -->
            <Style x:Key="TileButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Coloured page banner -->
            <Style TargetType="c:Hero">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:Hero">
                            <Grid>
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource SystemAccentColorLight1}" Offset="0" />
                                            <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0.45" />
                                            <GradientStop Color="{DynamicResource SystemAccentColorDark2}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="12" Background="{TemplateBinding Fill}" />
                                <Grid ClipToBounds="True" IsHitTestVisible="False">
                                    <Ellipse Width="230" Height="230" Fill="#16FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,150,0" />
                                    <Ellipse Width="170" Height="170" Fill="#16FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,-115" />
                                </Grid>
                                <Grid Margin="24,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="28" Background="#33FFFFFF" VerticalAlignment="Center">
                                        <ui:FontIcon Glyph="{TemplateBinding Glyph}" FontSize="26" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="28" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{TemplateBinding Subtitle}" Foreground="#EBFFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MutedCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
