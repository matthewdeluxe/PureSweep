<Window x:Class="PureSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="PureSweep" Width="1100" Height="740" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <ui:NavigationView x:Name="Nav"
                       PaneDisplayMode="Left"
                       OpenPaneLength="232"
                       IsBackButtonVisible="Collapsed"
                       IsSettingsVisible="True"
                       PaneTitle="PureSweep"
                       SelectionChanged="Nav_SelectionChanged">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Home" Tag="home">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE80F;" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Cleanup" Tag="cleanup">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xEA99;" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Uninstaller" Tag="uninstaller">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE71D;" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Startup" Tag="startup">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE7E8;" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Hibernation" Tag="hibernation">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE708;" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem Content="Shredder" Tag="shredder">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE75C;" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>
        <ContentControl x:Name="Host" Focusable="False" />
    </ui:NavigationView>
</Window>
