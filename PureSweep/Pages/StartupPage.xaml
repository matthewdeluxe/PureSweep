<UserControl x:Class="PureSweep.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls">
    <Grid Margin="32,20,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:Hero x:Name="Banner" Title="Startup" Subtitle="Programs that launch when you sign in. Disabling one is reversible." Glyph="&#xE7E8;" From="#FF3CCB7F" To="#FF0A8F7A">
            <Button Content="Refresh" Style="{StaticResource Push3DHero}" Click="Refresh_Click" />
        </c:Hero>

        <ScrollViewer Grid.Row="1" Margin="0,12,-16,0" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Opacity="{Binding RowOpacity}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource MutedCaption}" ToolTip="{Binding Command}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{Binding StatusBrush}" CornerRadius="11" Padding="10,2,10,3" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" /></Border>
                                <Button Grid.Column="2" Content="{Binding ActionText}" Style="{StaticResource Push3D}" Padding="14,6,14,7" MinWidth="96" Tag="{Binding}" Click="Toggle_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
