<UserControl x:Class="PureSweep.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Grid Margin="32,20,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Summary hero with the round Scan / Clean plunger -->
        <Grid>
            <Border CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource SystemAccentColorLight1}" Offset="0" />
                        <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource SystemAccentColorDark2}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <Ellipse Width="320" Height="320" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,260,0" />
                <Ellipse Width="200" Height="200" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="320,0,0,-140" />
            </Grid>
            <Grid Margin="28,20,36,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CLEANUP" FontSize="12" FontWeight="Bold" Foreground="#CCFFFFFF" />
                    <TextBlock x:Name="TotalText" Text="Ready to scan" FontSize="44" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="StatusText" Text="Press Scan to see how much space you can reclaim." Foreground="#EBFFFFFF" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiskText" FontSize="12" Foreground="#EBFFFFFF" Margin="0,16,0,4" />
                    <ProgressBar x:Name="DiskBar" Maximum="100" Height="6" Width="380" HorizontalAlignment="Left" Foreground="White" Background="#40FFFFFF" />
                    <!-- scan / clean progress; takes the disk bar's place while working -->
                    <Grid x:Name="WorkRow" Width="430" HorizontalAlignment="Left" Margin="0,18,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="WorkTrack" Height="8" VerticalAlignment="Center">
                            <Border CornerRadius="4" Background="#40FFFFFF" />
                            <Border x:Name="WorkFill" CornerRadius="4" Background="White" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="WorkPct" Grid.Column="1" Text="0%" MinWidth="42" Margin="12,0,0,0" TextAlignment="Right"
                                   FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </Grid>
                    <!-- quiet secondary link; the round button is the page's one primary action -->
                    <Button x:Name="RescanBtn" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="Collapsed" Click="Rescan_Click"
                            Cursor="Hand" Foreground="White" AutomationProperties.Name="Scan again">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="T" Text="Scan again" FontSize="13" Foreground="{TemplateBinding Foreground}"
                                           TextDecorations="Underline" Background="Transparent" Opacity="0.85" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="T" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="T" Property="Opacity" Value="1" />
                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="T" Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="1" Width="196" Height="196" VerticalAlignment="Center">
                    <!-- The one primary action. It changes in place: Scan -> Stop -> Clean (size) -> Cleaning -> Rescan. -->
                    <Button x:Name="MainBtn" Style="{StaticResource RoundPush3D}" Click="Main_Click"
                            HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Scan">
                        <StackPanel>
                            <TextBlock x:Name="MainLabel" Text="Scan" HorizontalAlignment="Center" />
                            <TextBlock x:Name="MainSub" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- Limited-mode banner -->
        <Border x:Name="AdminBar" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Running without administrator rights. System locations marked below can't be cleaned." />
                <Button Grid.Column="2" Content="Restart as administrator" Click="Elevate_Click" Style="{StaticResource Push3D}" Padding="14,6,14,7" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,12,-16,0" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="16,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" MinWidth="28" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="10" Margin="4,0,16,0" Background="{Binding Tint}" VerticalAlignment="Center">
                                        <Grid>
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#40FFFFFF" Offset="0" />
                                                        <GradientStop Color="#1F000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ui:FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="White" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Border Visibility="{Binding AdminBadge}" Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="Needs administrator" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="110">
                                        <TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Tag="{Binding}" Click="Expand_Click" Visibility="{Binding ExpandVisibility}"
                                            Background="Transparent" BorderThickness="0" Padding="10" Margin="8,0,-6,0" VerticalAlignment="Center"
                                            ToolTip="Show what's inside" AutomationProperties.Name="Show what's inside">
                                        <ui:FontIcon Glyph="{Binding ExpandGlyph}" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- drill-down: choose exactly which folders to clean -->
                                <Border Visibility="{Binding GroupsVisibility}" Margin="38,12,0,2" Padding="12,4" CornerRadius="6"
                                        Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsChecked}" MinWidth="28" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Location}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="4,0,12,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DetailText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
