<UserControl x:Class="PureSweep.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls">
    <!--
        Four states, switched by UpdateMode() in code: start screen -> working (scan or clean) -> results list -> cleaned.
        The round button at the bottom is the page's one primary action and changes in place:
        Scan -> Stop -> Clean (size) -> Cleaning -> Rescan.
    -->
    <Grid Margin="32,12,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Results header: big total, status and a quiet rescan -->
        <Grid x:Name="Header" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TotalText" Text="Clean up your PC" FontSize="44" FontWeight="Bold" Foreground="White" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"
                           Text="Find temporary files, caches, logs and other files Windows doesn't need. Nothing is deleted until you choose to clean." />
            </StackPanel>
            <Button x:Name="RescanBtn" Grid.Column="1" Content="Scan again" Style="{StaticResource Push3D}" VerticalAlignment="Top"
                    Margin="16,10,0,0" Visibility="Collapsed" Click="Rescan_Click" />
        </Grid>

        <!-- Limited-mode banner -->
        <Border x:Name="AdminBar" Grid.Row="1" Margin="0,14,0,0" Padding="14,10" CornerRadius="12"
                Background="#2E000000" BorderBrush="#73FFB347" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:FontIcon Glyph="&#xE7EF;" FontSize="18" Foreground="#FFFFB347" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#E6FFFFFF"
                           Text="Running without administrator rights. System locations marked below can't be cleaned." />
                <Button Grid.Column="2" Content="Restart as administrator" Click="Elevate_Click" Style="{StaticResource Push3D}" />
            </Grid>
        </Border>

        <!-- Results list -->
        <ScrollViewer x:Name="ListArea" Grid.Row="2" Margin="0,14,-16,0" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" MinWidth="28" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name}" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Margin="4,0,14,0" Background="{Binding Tint}" VerticalAlignment="Center">
                                        <Grid>
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#33FFFFFF" Offset="0" />
                                                        <GradientStop Color="#33000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ui:FontIcon Glyph="{Binding Glyph}" FontSize="18" Foreground="White" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" />
                                            <Border Visibility="{Binding AdminBadge}" Margin="8,0,0,0" Padding="7,1,7,2" CornerRadius="9"
                                                    Background="#38FFB347" VerticalAlignment="Center">
                                                <TextBlock Text="Needs administrator" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFB347" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="110">
                                        <TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Tag="{Binding}" Click="Expand_Click" Visibility="{Binding ExpandVisibility}"
                                            Background="Transparent" BorderThickness="0" Padding="10" Margin="8,0,-6,0" VerticalAlignment="Center"
                                            Foreground="#CCFFFFFF" ToolTip="Show what's inside" AutomationProperties.Name="Show what's inside">
                                        <ui:FontIcon Glyph="{Binding ExpandGlyph}" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- drill-down: choose exactly which folders to clean -->
                                <Border Visibility="{Binding GroupsVisibility}" Padding="66,6,56,8" Background="#26000000">
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsChecked}" MinWidth="28" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Name}" />
                                                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Location}" Style="{StaticResource MutedCaption}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DetailText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Rectangle Height="1" Fill="#14FFFFFF" Margin="62,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- Start, working and cleaned screens: emblem, headline and explanation -->
        <StackPanel x:Name="Center" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
            <c:Emblem x:Name="Emblem" Glyph="&#xEA99;" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Text, ElementName=TotalText}" FontSize="30" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,18,0,6" />
            <TextBlock Text="{Binding Text, ElementName=StatusText}" FontSize="16" Foreground="{StaticResource TextSoft}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
            <TextBlock x:Name="WorkPct" Text="0%" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <StackPanel x:Name="DiskPanel" HorizontalAlignment="Center" Margin="0,18,0,0" Width="320">
                <ProgressBar x:Name="DiskBar" Maximum="100" Height="4" Foreground="White" Background="#33FFFFFF" />
                <TextBlock x:Name="DiskText" FontSize="12" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="ReviewLink" Content="Review what's left" Style="{StaticResource Link}" HorizontalAlignment="Center"
                    Margin="0,14,0,0" Click="Review_Click" />
        </StackPanel>

        <!-- The one primary action, with scan/clean progress drawn around it -->
        <Grid Grid.Row="3" Width="152" Height="152" Margin="0,16,0,0" HorizontalAlignment="Center">
            <c:RingGauge x:Name="WorkRing" Thickness="5" Visibility="Collapsed" IsHitTestVisible="False">
                <c:RingGauge.Stroke>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                </c:RingGauge.Stroke>
            </c:RingGauge>
            <Button x:Name="MainBtn" Style="{StaticResource RoundPush3D}" Click="Main_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Scan">
                <StackPanel>
                    <TextBlock x:Name="MainLabel" Text="Scan" HorizontalAlignment="Center" />
                    <TextBlock x:Name="MainSub" FontSize="12" FontWeight="SemiBold" Opacity="0.85" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
