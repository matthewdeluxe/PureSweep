<UserControl x:Class="PureSweep.Pages.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls">
    <Grid Margin="32,20,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:Hero Title="Uninstaller" Subtitle="Remove desktop programs you no longer use." Glyph="&#xE71D;" From="#FFFF9A3D" To="#FFE8452C" />

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" ui:ControlHelper.PlaceholderText="Search installed programs" TextChanged="Filter_Changed" />
            <TextBlock x:Name="CountText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" />
            <ComboBox x:Name="Sort" Grid.Column="2" MinWidth="160" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Sort by name" />
                <ComboBoxItem Content="Sort by size" />
                <ComboBoxItem Content="Sort by publisher" />
            </ComboBox>
        </Grid>

        <ListView x:Name="List" Grid.Row="2" Margin="-12,0,-16,0" SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE7B8;" FontSize="24" Width="32" Height="32"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Image Source="{Binding Icon}" Width="32" Height="32" />
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="0,0,24,0" />
                        <Button Grid.Column="3" Content="Uninstall" Style="{StaticResource Push3D}" Padding="14,6,14,7" Tag="{Binding}" Click="Uninstall_Click" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ui:ProgressRing x:Name="Ring" Grid.Row="2" Width="48" Height="48" IsActive="True" />
    </Grid>
</UserControl>
