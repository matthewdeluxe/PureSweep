<UserControl x:Class="PureSweep.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,12,32,24" MaxWidth="760" HorizontalAlignment="Left">
            <c:Hero Title="Settings" Subtitle="Cleaning behaviour and history." Glyph="&#xE713;" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keep recent temporary files" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Skip temp and log files changed in the last 24 hours, since running apps and installers may still need them."
                                   Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="KeepRecent" Grid.Column="1" Toggled="KeepRecent_Toggled" MinWidth="0" Margin="16,0,0,0"
                                     OnContent="" OffContent="" AutomationProperties.Name="Keep recent temporary files" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Cleaning history" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                    <TextBlock x:Name="LastText" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="TotalText" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <TextBlock Text="About" FontWeight="SemiBold" Foreground="White" Margin="0,24,0,4" />
            <TextBlock Text="PureSweep 1.0  •  Built with WPF and ModernWpf. Also available for macOS." Style="{StaticResource Muted}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
