<UserControl x:Class="PureSweep.Pages.ShredderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:PureSweep.Controls">
    <Grid Margin="32,12,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:Hero Title="Shredder" Subtitle="Overwrite files with random data before deleting them. Most effective on hard disks; SSDs and cloud-synced folders can keep other copies." Glyph="&#xE75C;" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="8" AllowDrop="True" Drop="Zone_Drop" DragOver="Zone_DragOver">
            <Grid>
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <c:Emblem Glyph="&#xE896;" Width="160" Height="160" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag files or folders here" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="or use the buttons below" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="List" SelectionMode="Single" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Remove" Style="{StaticResource Push3D}" Padding="12,5,12,6" Tag="{Binding}" Click="Remove_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Add files" Style="{StaticResource Push3D}" Click="AddFiles_Click" />
            <Button Grid.Column="1" Content="Add folder" Style="{StaticResource Push3D}" Click="AddFolder_Click" Margin="8,0,0,0" />
            <TextBlock x:Name="Status" Grid.Column="2" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource MutedCaption}" />
            <ComboBox x:Name="Passes" Grid.Column="3" SelectedIndex="0" MinWidth="130" Margin="0,0,8,0">
                <ComboBoxItem Content="1 pass (fast)" Tag="1" />
                <ComboBoxItem Content="3 passes" Tag="3" />
                <ComboBoxItem Content="7 passes" Tag="7" />
            </ComboBox>
            <Button x:Name="ShredBtn" Grid.Column="4" Content="Shred" MinWidth="120" IsEnabled="False"
                    Style="{StaticResource Push3DDanger}" Click="Shred_Click" />
        </Grid>
    </Grid>
</UserControl>
